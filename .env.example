# AI Server Manager — omgevingsvariabelen (ALLEEN voor ontwikkeling/CI; géén echte waarden, géén geheimen).
# De standaard TrueNAS Custom App heeft GEEN verplichte variabelen: alle standaardwaarden werken in de image.
# NAS-gegevens (IP, poolnaam, versie) staan hier nooit: die komen uit de onboarding-wizard (D01–D18) of uit
# gemeten TrueNAS-readback.

# --- Hub (prefix HUB_) ---
# Datamap met postgres/, secrets/ en backups/ (in de image: /appdata).
HUB_DATA_DIR=./.appdata
# Database (in de image: unix-socket, geen wachtwoord). Voor ontwikkeling: eigen database met prefix asm_.
HUB_DATABASE_URL=postgresql+psycopg://postgres@127.0.0.1:5432/asm_dev
# HTTP-poort van de API (in de image 30400; met web-UI luistert de API intern op HUB_INTERNAL_API_PORT).
HUB_PORT=30400
HUB_INTERNAL_API_PORT=8400
HUB_LOG_LEVEL=info
# Cookies: auto = Secure alleen achter HTTPS.
HUB_COOKIE_SECURE=auto
HUB_SESSION_TTL_SECONDS=43200
HUB_SESSION_IDLE_SECONDS=7200
HUB_LOGIN_MAX_FAILURES=5
HUB_LOGIN_WINDOW_SECONDS=900
HUB_PASSWORD_MIN_LENGTH=12
HUB_SETUP_CODE_TTL_SECONDS=86400
# Dienst-JWT's: maximaal 120 s (contract §4).
HUB_JWT_TTL_SECONDS=120
HUB_ENROLLMENT_TOKEN_TTL_SECONDS=3600
HUB_PAIRING_CODE_TTL_SECONDS=3600
HUB_SERVICE_TOKEN_ROTATION_GRACE_SECONDS=600
# TrueNAS JSON-RPC (contract §5: 5 s connect / 15 s read). Optioneel eigen CA-bestand (PEM) i.p.v. vingerafdruk.
HUB_TRUENAS_CONNECT_TIMEOUT=5
HUB_TRUENAS_READ_TIMEOUT=15
# HUB_TRUENAS_EXTRA_CA_FILE=/pad/naar/ca.pem
HUB_INVENTORY_TTL_SECONDS=900
HUB_INVENTORY_INTERVAL_SECONDS=300
HUB_SELF_BACKUP_INTERVAL_SECONDS=86400
HUB_SELF_BACKUP_KEEP=7
HUB_PG_DUMP_BIN=pg_dump
HUB_PG_RESTORE_BIN=pg_restore
HUB_WORKER_POLL_SECONDS=5
# AI staat standaard uit (lokale modellen optioneel en standaard uit; nooit betaalde overage).
HUB_AI_ENABLED=false

# --- Web-UI (apps/web; Next.js) ---
# Interne API waar de webserver /api/*, /connector/*, /healthz en /readyz naartoe doorzet (alleen 127.0.0.1/localhost).
HUB_API_URL=http://127.0.0.1:8400
# Poort en adres van de webserver (in de image: 30400 op 0.0.0.0; in ontwikkeling standaard 3000 op 127.0.0.1).
PORT=3000
HOSTNAME=127.0.0.1
# Komma-gescheiden IP-adressen van vertrouwde reverse proxy's (bv. een latere HTTPS-proxy, D17). Leeg = de webserver
# vertrouwt geen enkele X-Forwarded-*-header van buiten en zet zelf het echte client-adres.
HUB_WEB_TRUSTED_PROXIES=
NEXT_TELEMETRY_DISABLED=1
# Web-E2E (Playwright): poorten van de teststack en de Python met het hub-pakket.
HUB_E2E_WEB_PORT=39400
HUB_E2E_API_PORT=39401
HUB_E2E_CONTROL_PORT=39402
# HUB_E2E_PYTHON=.venv/bin/python
# Tegen de alles-in-één image i.p.v. de teststack (zie apps/web/README.md):
# HUB_E2E_BASE_URL=http://127.0.0.1:30400
# HUB_E2E_SETUP_CODE=<code uit de containerlog>

# --- Executor (prefix EXECUTOR_) ---
EXECUTOR_DATA_DIR=./.appdata-executor
EXECUTOR_PORT=30410
EXECUTOR_LOG_LEVEL=info

# --- Tests ---
# PostgreSQL voor integratietests (maakt en verwijdert zelf een database asm_test_<id>).
HUB_TEST_ADMIN_URL=postgresql://postgres@127.0.0.1:5432/postgres
