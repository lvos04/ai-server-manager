# AI Server Manager — omgevingsvariabelen (ALLEEN voor ontwikkeling/CI; géén echte waarden, géén geheimen).
# De standaard TrueNAS Custom App heeft GEEN verplichte variabelen: alle standaardwaarden werken in de image.
# NAS-gegevens (IP, poolnaam, versie) staan hier nooit: die komen uit de onboarding-wizard (D01–D18) of uit
# gemeten TrueNAS-readback.

# --- Hub (prefix HUB_) ---
# Datamap met postgres/, secrets/ en backups/ (in de image: /appdata).
HUB_DATA_DIR=./.appdata
# Database (in de image: unix-socket, geen wachtwoord). Voor ontwikkeling: eigen database met prefix asm_.
HUB_DATABASE_URL=postgresql+psycopg://postgres@127.0.0.1:5432/asm_dev
# HTTP-poort van de API (in de image 30400; met web-UI luistert de API intern op HUB_INTERNAL_API_PORT).
HUB_PORT=30400
HUB_INTERNAL_API_PORT=8400
HUB_LOG_LEVEL=info
# Cookies: auto = Secure alleen achter HTTPS.
HUB_COOKIE_SECURE=auto
HUB_SESSION_TTL_SECONDS=43200
HUB_SESSION_IDLE_SECONDS=7200
HUB_LOGIN_MAX_FAILURES=5
HUB_LOGIN_WINDOW_SECONDS=900
HUB_PASSWORD_MIN_LENGTH=12
HUB_SETUP_CODE_TTL_SECONDS=86400
# Dienst-JWT's: maximaal 120 s (contract §4).
HUB_JWT_TTL_SECONDS=120
# Enrollment (contract 1.2 §3.3–§3.8). Tokens en koppelcodes 60 min, executor-koppelcode 30 min.
HUB_ENROLLMENT_TOKEN_TTL_SECONDS=3600
HUB_PAIRING_CODE_TTL_SECONDS=3600
HUB_EXECUTOR_PAIRING_CODE_TTL_SECONDS=1800
# Na 10 mislukte pogingen (401) per bron-IP binnen 15 min → 429 met Retry-After.
HUB_ENROLL_MAX_FAILURES=10
HUB_ENROLL_WINDOW_SECONDS=900
# Oud service-token blijft na een rotatie geldig tot 10 min na het eerste gebruik van het nieuwe, hooguit 24 uur.
HUB_SERVICE_TOKEN_ROTATION_GRACE_SECONDS=600
HUB_SERVICE_TOKEN_ROTATION_MAX_SECONDS=86400
# Melding "rotatie aanbevolen" na zoveel dagen (de Hub roteert nooit zelf).
HUB_SERVICE_TOKEN_ROTATION_ADVICE_DAYS=180
# Hub → eigen dienst (dienst-JWT; nooit redirects of proxy): 5 s connect / 15 s read.
HUB_SERVICE_CALL_CONNECT_TIMEOUT=5
HUB_SERVICE_CALL_READ_TIMEOUT=15
# Noodlogin (contract 1.2 §4.1): wachtwoord ≥ 20 tekens + TOTP, sessie standaard 60 min (5–240), herbevestiging 90 dagen.
HUB_BREAK_GLASS_PASSWORD_MIN_LENGTH=20
HUB_BREAK_GLASS_SESSION_MINUTES_DEFAULT=60
HUB_BREAK_GLASS_RECONFIRM_DAYS=90
# TrueNAS JSON-RPC (contract §5: 5 s connect / 15 s read). Optioneel eigen CA-bestand (PEM) i.p.v. vingerafdruk.
HUB_TRUENAS_CONNECT_TIMEOUT=5
HUB_TRUENAS_READ_TIMEOUT=15
# HUB_TRUENAS_EXTRA_CA_FILE=/pad/naar/ca.pem
HUB_INVENTORY_TTL_SECONDS=900
HUB_INVENTORY_INTERVAL_SECONDS=300
HUB_SELF_BACKUP_INTERVAL_SECONDS=86400
HUB_SELF_BACKUP_KEEP=7
HUB_PG_DUMP_BIN=pg_dump
HUB_PG_RESTORE_BIN=pg_restore
HUB_WORKER_POLL_SECONDS=5
# Monitoring (B09, ADR-0021): pollinterval van Uptime Kuma/Beszel/eigen diensten, live NAS-metingen
# (reporting.realtime) en veroudering. Ouder dan de TTL → unknown (nooit 'nog gezond').
HUB_MONITORING_INTERVAL_SECONDS=60
HUB_NAS_METRICS_INTERVAL_SECONDS=30
HUB_NAS_METRICS_TTL_SECONDS=180
HUB_MONITOR_TTL_SECONDS=300
HUB_HEALTH_RECORD_INTERVAL_SECONDS=60
HUB_CONNECTOR_FAIL_THRESHOLD=2
# Tijdreeksen: maximum aantal reeksen en retentie (ruw / 5 min / 1 uur) in seconden.
HUB_METRICS_MAX_SERIES=2000
HUB_METRICS_RAW_RETENTION_SECONDS=172800
HUB_METRICS_5M_RETENTION_SECONDS=2592000
HUB_METRICS_1H_RETENTION_SECONDS=34560000
HUB_METRICS_MAINTENANCE_INTERVAL_SECONDS=300
# Alerts: evaluatie-interval en hoe lang een meting vers blijft (verouderd → geen overgang).
HUB_ALERT_INTERVAL_SECONDS=30
HUB_ALERT_STALE_SECONDS=600
# Meldingen (Gotify): maximaal aantal pogingen en hoe lang een melding in de wachtrij mag staan.
HUB_NOTIFY_MAX_ATTEMPTS=8
HUB_NOTIFY_EXPIRE_SECONDS=86400
# Uitgaand verkeer naar bronnen/kanalen: nooit redirects of proxy. Loopback/link-local alleen voor tests (nooit in de
# image). Optioneel een eigen CA-bestand (PEM) voor https-bronnen.
HUB_OUTBOUND_ALLOW_LOOPBACK=false
# HUB_OUTBOUND_EXTRA_CA_FILE=/pad/naar/ca.pem
# Auditspoor (ADR-0022): kop van de hash-ketting naar /appdata/audit/anker.jsonl en volledige controle (seconden).
HUB_AUDIT_ANCHOR_INTERVAL_SECONDS=900
HUB_AUDIT_VERIFY_INTERVAL_SECONDS=86400
# Incidenten (B01-005/B09-006): verwerking, heropenvenster, escalatie van kritieke incidenten, retentie en veilige modus
# (na zoveel keer opnieuw falen binnen het venster geen herstartvoorstel meer).
HUB_INCIDENT_INTERVAL_SECONDS=15
HUB_INCIDENT_BATCH=500
HUB_INCIDENT_REOPEN_WINDOW_SECONDS=3600
HUB_INCIDENT_MAX_EVENTS=500
HUB_INCIDENT_SNOOZE_MAX_KRITIEK_MINUTES=1440
HUB_INCIDENT_ESCALATION_SECONDS=1800
HUB_INCIDENT_MAX_ESCALATIONS=3
HUB_INCIDENT_RETENTION_DAYS=180
HUB_INCIDENT_SAFE_MODE_MAX_RESTARTS=2
HUB_INCIDENT_SAFE_MODE_WINDOW_SECONDS=3600
# Log-index (B09-004): alleen geschoonde regels; eigen logs vanaf dit niveau, retentie, maximum en rate-limit per dienst.
HUB_LOG_HUB_LEVEL=warning
HUB_LOG_RETENTION_SECONDS=1209600
HUB_LOG_MAX_ROWS=50000
HUB_LOG_INGEST_MAX_PER_MINUTE=1000
HUB_LOG_MAINTENANCE_INTERVAL_SECONDS=3600
# SSO (OIDC, ADR-0023) stel je in via de Hub-UI/API, niet via omgevingsvariabelen: het clientgeheim staat in de vault.
# AI staat standaard uit (lokale modellen optioneel en standaard uit; nooit betaalde overage).
HUB_AI_ENABLED=false

# --- Web-UI (apps/web; Next.js) ---
# Interne API waar de webserver /api/*, /connector/*, /healthz en /readyz naartoe doorzet (alleen 127.0.0.1/localhost).
HUB_API_URL=http://127.0.0.1:8400
# Poort en adres van de webserver (in de image: 30400 op 0.0.0.0; in ontwikkeling standaard 3000 op 127.0.0.1).
PORT=3000
HOSTNAME=127.0.0.1
# Komma-gescheiden IP-adressen van vertrouwde reverse proxy's (bv. een latere HTTPS-proxy, D17). Leeg = de webserver
# vertrouwt geen enkele X-Forwarded-*-header van buiten en zet zelf het echte client-adres.
HUB_WEB_TRUSTED_PROXIES=
NEXT_TELEMETRY_DISABLED=1
# Web-E2E (Playwright): poorten van de teststack en de Python met het hub-pakket.
HUB_E2E_WEB_PORT=39400
HUB_E2E_API_PORT=39401
HUB_E2E_CONTROL_PORT=39402
# HUB_E2E_PYTHON=.venv/bin/python
# Tegen de alles-in-één image i.p.v. de teststack (zie apps/web/README.md):
# HUB_E2E_BASE_URL=http://127.0.0.1:30400
# HUB_E2E_SETUP_CODE=<code uit de containerlog>

# --- Executor (prefix EXECUTOR_) ---
EXECUTOR_DATA_DIR=./.appdata-executor
EXECUTOR_PORT=30410
EXECUTOR_LOG_LEVEL=info
# Alleen ontwikkeling/CI: een Hub op 127.0.0.1 toestaan (in de image altijd uit; contract 1.2 §3.2).
EXECUTOR_ALLOW_LOOPBACK_HUB=false
# Koppelformulier op de statuspagina: max. pogingen per bron-IP en in totaal per venster (contract 1.2 §3.7).
EXECUTOR_PAIRING_ATTEMPTS_PER_IP=5
EXECUTOR_PAIRING_ATTEMPTS_TOTAL=20
EXECUTOR_PAIRING_WINDOW_SECONDS=900

# --- Tests ---
# PostgreSQL voor integratietests (maakt en verwijdert zelf een database asm_test_<id>).
HUB_TEST_ADMIN_URL=postgresql://postgres@127.0.0.1:5432/postgres
