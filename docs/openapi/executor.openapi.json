{
  "info": {
    "description": "Executor van TrueNAS Home Platform V2. Koppelen met de Hub via de statuspagina (koppelcode + vingerafdruk, contract 1.3 §3.9). Voert alleen acties van de allowlist uit het ingebakken beleid uit, en alleen met een door de Hub ondertekend ExecutionRequest dat de executor zelf opnieuw controleert (§8). Geen shell, sudo of Docker.",
    "title": "AI Server Manager — executor",
    "version": "0.1.0"
  },
  "openapi": "3.1.0",
  "paths": {
    "/api/v1/execute": {
      "post": {
        "operationId": "execute_api_v1_execute_post",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "additionalProperties": false,
                "properties": {
                  "approval": {
                    "description": "Gebonden goedkeuring (verplicht bij R2/R3): preview_hash, resource_etag, policy_hash, risk_class, expires_at (≤ 15 min), one_time_nonce, backup_checkpoint_id, action_scope.",
                    "type": [
                      "object",
                      "null"
                    ]
                  },
                  "expires_at": {
                    "format": "date-time",
                    "type": "string"
                  },
                  "issued_at": {
                    "format": "date-time",
                    "type": "string"
                  },
                  "nonce": {
                    "format": "uuid",
                    "type": "string"
                  },
                  "policy_decision": {
                    "properties": {
                      "policy_hash": {
                        "type": "string"
                      },
                      "risk_class": {
                        "enum": [
                          "R0",
                          "R1",
                          "R2",
                          "R3"
                        ],
                        "type": "string"
                      },
                      "rule_ids": {
                        "items": {
                          "type": "string"
                        },
                        "type": "array"
                      }
                    },
                    "required": [
                      "risk_class",
                      "rule_ids",
                      "policy_hash"
                    ],
                    "type": "object"
                  },
                  "proposal": {
                    "description": "ActionProposal (§8), ongewijzigd zoals beoordeeld door de Hub.",
                    "type": "object"
                  },
                  "signature": {
                    "description": "Ed25519 over de canonieke JSON zonder dit veld (base64url).",
                    "type": "string"
                  }
                },
                "required": [
                  "proposal",
                  "approval",
                  "policy_decision",
                  "issued_at",
                  "expires_at",
                  "nonce",
                  "signature"
                ],
                "type": "object"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {}
              }
            },
            "description": "Uitgevoerd en teruggelezen: before/after-hash, nieuwe resource_etag en readback"
          },
          "400": {
            "description": "Idempotency-Key ontbreekt of is geen UUID (pas na de authenticatie)"
          },
          "401": {
            "description": "unauthorized (§4.7): zonder geldige aanmelding altijd 401, ook bij een foute body"
          },
          "403": {
            "description": "Geen dienst-JWT van de Hub, of het verzoek is geweigerd: handtekening_ongeldig, verzoek_verlopen, actie_geweigerd, actie_niet_toegestaan, risicoklasse_te_laag, goedkeuring_ontbreekt, goedkeuring_verlopen, goedkeuring_ongeldig"
          },
          "409": {
            "description": "Niets uitgevoerd: policy_hash_verschilt, nonce_al_gebruikt, goedkeuring_al_gebruikt, goedkeuring_past_niet, doel_gewijzigd, doel_bestaat_niet, doel_bestaat_al, doel_past_niet, pool_niet_gezond, backup_checkpoint_ontbreekt, herstelpunt_onbekend, executor_bezet, executor_gestopt. Of ná de aanroep: afwijking (readback wijkt af; de executor is gestopt)"
          },
          "422": {
            "description": "validation_error, execution_request_ongeldig of parameters_ongeldig"
          },
          "501": {
            "description": "capability_unavailable (geen schrijfsleutel, of TrueNAS kent de methode niet)"
          },
          "502": {
            "description": "uitvoering_mislukt of truenas_fout (de toestand is onveranderd teruggelezen)"
          },
          "503": {
            "description": "replay_check_unavailable, journaal_niet_beschikbaar, policy_niet_beschikbaar, policy_niet_read_only, schrijfsleutel_onleesbaar of TrueNAS onbereikbaar (niets uitgevoerd)"
          }
        },
        "summary": "Ondertekend ExecutionRequest uitvoeren (dienst-JWT van de Hub; de executor controleert alles opnieuw)",
        "tags": [
          "uitvoeren"
        ]
      }
    },
    "/api/v1/executions/{request_id}": {
      "get": {
        "operationId": "executions_api_v1_executions__request_id__get",
        "parameters": [
          {
            "in": "path",
            "name": "request_id",
            "required": true,
            "schema": {
              "title": "Request Id",
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {}
              }
            },
            "description": "Successful Response"
          },
          "401": {
            "description": "unauthorized (§4.7)"
          },
          "403": {
            "description": "geen dienst-JWT van de Hub"
          },
          "422": {
            "description": "request_id is geen UUID"
          },
          "503": {
            "description": "journaal_niet_beschikbaar"
          }
        },
        "summary": "Journaal van één actieverzoek (dienst-JWT van de Hub): methode, uitkomst, before/after-hash",
        "tags": [
          "uitvoeren"
        ]
      }
    },
    "/api/v1/status": {
      "get": {
        "operationId": "api_status_api_v1_status_get",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "additionalProperties": true,
                  "title": "Response Api Status Api V1 Status Get",
                  "type": "object"
                }
              }
            },
            "description": "Successful Response"
          }
        },
        "summary": "Koppelstatus (witte lijst), Gereed, beleid (policy_hash), allowlist en toestand van de schrijfsleutel",
        "tags": [
          "status"
        ]
      }
    },
    "/connector/v1/hub-link": {
      "get": {
        "operationId": "hub_link_connector_v1_hub_link_get",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {}
              }
            },
            "description": "Successful Response"
          }
        },
        "summary": "Koppelstatus (witte lijst §3.5 + gepinde kid's); dienst-JWT of gebruikers-JWT viewer+",
        "tags": [
          "connector"
        ]
      }
    },
    "/connector/v1/hub-link/unlink": {
      "post": {
        "operationId": "hub_link_unlink_connector_v1_hub_link_unlink_post",
        "responses": {
          "400": {
            "description": "Idempotency-Key ontbreekt of is geen UUID (pas na de authenticatie)"
          },
          "401": {
            "description": "unauthorized (reden §4.7, ook token_replayed)"
          },
          "403": {
            "description": "gebruikers-JWT zonder rol admin"
          },
          "501": {
            "content": {
              "application/json": {
                "schema": {}
              }
            },
            "description": "capability_unavailable"
          },
          "503": {
            "description": "replay_check_unavailable"
          }
        },
        "summary": "Ontkoppelen via de Hub kan niet: alleen op de executorpagina met een live geverifieerde schrijfkey",
        "tags": [
          "connector"
        ]
      }
    },
    "/healthz": {
      "get": {
        "operationId": "healthz_healthz_get",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "additionalProperties": {
                    "type": "string"
                  },
                  "title": "Response Healthz Healthz Get",
                  "type": "object"
                }
              }
            },
            "description": "Successful Response"
          }
        },
        "summary": "Proces leeft",
        "tags": [
          "gezondheid"
        ]
      }
    },
    "/readyz": {
      "get": {
        "operationId": "readyz_readyz_get",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {}
              }
            },
            "description": "Successful Response"
          }
        },
        "summary": "Eigen geheimen aanwezig en datamap beschrijfbaar (de koppeling telt niet mee, contract §5)",
        "tags": [
          "gezondheid"
        ]
      }
    }
  }
}
