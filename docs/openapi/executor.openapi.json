{
  "components": {
    "schemas": {
      "ExecuteIn": {
        "additionalProperties": true,
        "description": "Vorm volgt later ``ExecutionRequest`` (contract §8); in P0 wordt alleen ``action_id`` gelezen om te weigeren.",
        "properties": {
          "action_id": {
            "maxLength": 128,
            "minLength": 1,
            "title": "Action Id",
            "type": "string"
          }
        },
        "required": [
          "action_id"
        ],
        "title": "ExecuteIn",
        "type": "object"
      },
      "HTTPValidationError": {
        "properties": {
          "detail": {
            "items": {
              "$ref": "#/components/schemas/ValidationError"
            },
            "title": "Detail",
            "type": "array"
          }
        },
        "title": "HTTPValidationError",
        "type": "object"
      },
      "ValidationError": {
        "properties": {
          "ctx": {
            "title": "Context",
            "type": "object"
          },
          "input": {
            "title": "Input"
          },
          "loc": {
            "items": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "integer"
                }
              ]
            },
            "title": "Location",
            "type": "array"
          },
          "msg": {
            "title": "Message",
            "type": "string"
          },
          "type": {
            "title": "Error Type",
            "type": "string"
          }
        },
        "required": [
          "loc",
          "msg",
          "type"
        ],
        "title": "ValidationError",
        "type": "object"
      }
    }
  },
  "info": {
    "description": "Executor van TrueNAS Home Platform V2. Koppelen met de Hub via de statuspagina (koppelcode + vingerafdruk, contract 1.2 §3.9). De allowlist is leeg tot P2: elke actie wordt geweigerd. Geen shell, sudo of Docker.",
    "title": "AI Server Manager — executor",
    "version": "0.1.0"
  },
  "openapi": "3.1.0",
  "paths": {
    "/api/v1/execute": {
      "post": {
        "operationId": "execute_api_v1_execute_post",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/ExecuteIn"
              }
            }
          },
          "required": true
        },
        "responses": {
          "403": {
            "content": {
              "application/json": {
                "schema": {}
              }
            },
            "description": "Actie geweigerd"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          }
        },
        "summary": "Weigert alles (allowlist leeg tot P2)",
        "tags": [
          "uitvoeren"
        ]
      }
    },
    "/api/v1/status": {
      "get": {
        "operationId": "api_status_api_v1_status_get",
        "responses": {
