{
  "info": {
    "description": "Executor van TrueNAS Home Platform V2. Koppelen met de Hub via de statuspagina (koppelcode + vingerafdruk, contract 1.3 §3.9). De allowlist is leeg tot P2: elke actie wordt geweigerd. Geen shell, sudo of Docker.",
    "title": "AI Server Manager — executor",
    "version": "0.1.0"
  },
  "openapi": "3.1.0",
  "paths": {
    "/api/v1/execute": {
      "post": {
        "operationId": "execute_api_v1_execute_post",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "additionalProperties": true,
                "description": "Vorm volgt later ``ExecutionRequest`` (contract §8); tot P2 wordt alleen ``action_id`` gelezen om te weigeren.",
                "properties": {
                  "action_id": {
                    "maxLength": 128,
                    "minLength": 1,
                    "title": "Action Id",
                    "type": "string"
                  }
                },
                "required": [
                  "action_id"
                ],
                "title": "ExecuteIn",
                "type": "object"
              }
            }
          },
          "required": true
        },
        "responses": {
          "400": {
            "description": "Idempotency-Key ontbreekt of is geen UUID (pas na de authenticatie)"
          },
          "401": {
            "description": "unauthorized (§4.7): zonder geldige aanmelding altijd 401, ook bij een foute body"
          },
          "403": {
            "content": {
              "application/json": {
                "schema": {}
              }
            },
            "description": "Actie geweigerd (allowlist leeg), of geen dienst-JWT van de Hub"
          },
          "422": {
            "description": "validation_error (pas na de authenticatie)"
          }
        },
        "summary": "Weigert alles (allowlist leeg tot P2); eerst authenticatie met een dienst-JWT van de Hub",
        "tags": [
          "uitvoeren"
        ]
      }
    },
    "/api/v1/status": {
      "get": {
        "operationId": "api_status_api_v1_status_get",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "additionalProperties": true,
                  "title": "Response Api Status Api V1 Status Get",
                  "type": "object"
                }
              }
            },
            "description": "Successful Response"
          }
        },
        "summary": "Koppelstatus (witte lijst), Gereed en (lege) allowlist",
        "tags": [
          "status"
        ]
      }
    },
    "/connector/v1/hub-link": {
      "get": {
        "operationId": "hub_link_connector_v1_hub_link_get",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {}
              }
            },
            "description": "Successful Response"
          }
        },
        "summary": "Koppelstatus (witte lijst §3.5 + gepinde kid's); dienst-JWT of gebruikers-JWT viewer+",
        "tags": [
          "connector"
        ]
      }
    },
    "/connector/v1/hub-link/unlink": {
      "post": {
        "operationId": "hub_link_unlink_connector_v1_hub_link_unlink_post",
        "responses": {
          "400": {
            "description": "Idempotency-Key ontbreekt of is geen UUID (pas na de authenticatie)"
          },
          "401": {
            "description": "unauthorized (reden §4.7, ook token_replayed)"
          },
          "403": {
            "description": "gebruikers-JWT zonder rol admin"
          },
          "501": {
            "content": {
              "application/json": {
                "schema": {}
              }
            },
            "description": "capability_unavailable"
          },
          "503": {
            "description": "replay_check_unavailable"
          }
        },
        "summary": "Ontkoppelen: nog niet beschikbaar voor de executor (vraagt een live geverifieerde schrijfkey, P2)",
        "tags": [
          "connector"
        ]
      }
    },
    "/healthz": {
      "get": {
        "operationId": "healthz_healthz_get",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "additionalProperties": {
                    "type": "string"
                  },
                  "title": "Response Healthz Healthz Get",
                  "type": "object"
                }
              }
            },
            "description": "Successful Response"
          }
        },
        "summary": "Proces leeft",
        "tags": [
          "gezondheid"
        ]
      }
    },
    "/readyz": {
      "get": {
        "operationId": "readyz_readyz_get",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {}
              }
            },
            "description": "Successful Response"
          }
        },
        "summary": "Eigen geheimen aanwezig en datamap beschrijfbaar (de koppeling telt niet mee, contract §5)",
        "tags": [
          "gezondheid"
        ]
      }
    }
  }
}
