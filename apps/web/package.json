{
  "name": "hub-web",
  "version": "0.1.0",
  "private": true,
  "description": "AI Server Manager — Hub-web-UI (Next.js PWA, Nederlands). Draait in de alles-in-één image op poort 30400.",
  "engines": {
    "node": ">=22.12.0 <23"
  },
  "scripts": {
    "dev": "node server/hub-server.mjs --dev",
    "build": "next build",
    "start": "node server/hub-server.mjs",
    "lint": "eslint --max-warnings=0 .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "e2e": "playwright test",
    "icons": "node scripts/make-icons.mjs"
  },
  "dependencies": {
    "next": "16.4.5",
    "react": "19.3.1",
    "react-dom": "19.3.1"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.14.0",
    "@playwright/test": "1.63.0",
    "@types/node": "22.20.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "eslint": "9.39.5",
    "eslint-config-next": "16.4.5",
    "typescript": "5.9.3",
    "vitest": "5.1.0"
  },
  "overrides": {
    "playwright-core": "1.63.0"
  }
}
