  "D06": {
    "$defs": {
      "PoolGezondheid": {
        "additionalProperties": false,
        "properties": {
          "gebruik_pct": {
            "anyOf": [
              {
                "maximum": 100,
                "minimum": 0,
                "type": "number"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "title": "Gebruik Pct"
          },
          "gezond": {
            "title": "Gezond",
            "type": "boolean"
          },
          "laatste_scrub": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
