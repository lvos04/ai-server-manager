        },
        "required": [
          "naam",
          "status",
          "gezond"
        ],
        "title": "PoolGezondheid",
        "type": "object"
      }
    },
    "additionalProperties": false,
    "properties": {
      "pools": {
        "items": {
          "$ref": "#/$defs/PoolGezondheid"
